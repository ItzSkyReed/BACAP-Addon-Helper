<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet Package Metadata -->
        <PackageId>BACAP-Addon-Helper.Core</PackageId>
        <Authors>ItzSkyReed</Authors>
        <Description>Core functionality for BACAP Addon Helper</Description>
        <RepositoryUrl>https://github.com/ItzSkyReed/BACAP-Addon-Helper</RepositoryUrl>
        <PackageLicenseExpression>CC-BY-NC-SA-4.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pidgin" Version="3.5.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="TextComponents\Serialization\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Core.Tests" />
    </ItemGroup>

</Project>