<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Enables XML documentation generation so Core.xml exists for packaging -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Pidgin" Version="3.5.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Core.Tests" />
    </ItemGroup>
</Project>