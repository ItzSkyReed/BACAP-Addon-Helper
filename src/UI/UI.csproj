<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Final binary name: BACAP_Addon_Helper.exe -->
        <AssemblyName>BACAP_Addon_Helper</AssemblyName>
        <RootNamespace>UI</RootNamespace>

        <!-- Application metadata -->
        <Product>BACAP Addon Helper</Product>
        <Version>0.0.2+mc26.3</Version>
        <Authors>ItzSkyReed</Authors>
        <Description>Interactive CLI tool for managing and generating BACAP datapacks and language files.</Description>

        <!-- Code quality & analyzers -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Suppress CA1707 (assembly name contains underscores) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>

        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="default_config.yaml" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BacapGenerator\BacapGenerator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
        <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

</Project>